# =============================================================================
# uSipipo VPN Agent Configuration Template
# =============================================================================
# Copy this file as .env and configure with real values
# NEVER commit .env to git - it contains sensitive credentials
# =============================================================================

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
AGENT_PORT=8080

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log Level: INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO

# Log Format: json, text (default: json)
LOG_FORMAT=json

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
# Backend URL (HTTP, not HTTPS - backend runs behind Caddy)
BACKEND_URL=http://your-backend-url.com

# Agent API Key (pre-generated from backend admin panel)
# Generate with: POST /api/v1/admin/agent-api-keys
# Format: agent_[32 alphanumeric characters]
AGENT_API_KEY=agent_your-api-key-here

# Server ID (auto-filled after first registration, leave empty initially)
# The agent will automatically register with the backend and save the UUID here
SERVER_ID=

# =============================================================================
# AGENT METADATA (for auto-registration)
# =============================================================================
# Agent API URL (public URL where agent can be reached)
AGENT_URL=http://localhost:8080

# Feature flags
SUPPORTS_OUTLINE=true
SUPPORTS_WIREGUARD=true

# =============================================================================
# VPN CONFIGURATION
# =============================================================================
# Outline Manager API URL
OUTLINE_API_URL=http://localhost:8081

# WireGuard interface name
WG_INTERFACE=wg0

# WireGuard server public IP (used in client configs as endpoint)
WG_SERVER_IP=your-server-public-ip

# WireGuard server listening port
WG_SERVER_PORT=51820

# =============================================================================
# TRUSTTUNNEL CONFIGURATION
# =============================================================================
# TrustTunnel binary path
TRUSTTUNNEL_BINARY=/opt/trusttunnel/trusttunnel_endpoint

# TrustTunnel configuration directory
TRUSTTUNNEL_CONFIG_DIR=/opt/trusttunnel

# TrustTunnel public domain (for client endpoint)
TRUSTTUNNEL_DOMAIN=usipipotunnel.duckdns.org

# TrustTunnel listening port
TRUSTTUNNEL_PORT=8443

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# TLS Verification (default: true - DO NOT disable in production)
# Set to false ONLY for development with self-signed certificates
OUTLINE_VERIFY_SSL=true

# HTTP Client Timeout (default: 30s)
# Maximum time for HTTP client operations (e.g., 30s, 1m, 5m)
HTTP_CLIENT_TIMEOUT=30s

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true

# General API Rate Limits
RATE_LIMIT_RPS=5           # Requests per second for general API
RATE_LIMIT_BURST=10        # Burst size for general API

# Auth Endpoint Rate Limits (stricter)
RATE_LIMIT_AUTH_RPS=3      # Requests per second for auth endpoints
RATE_LIMIT_AUTH_BURST=5    # Burst size for auth endpoints

# Per-API-Key Rate Limits
RATE_LIMIT_KEY_RPS=100     # Requests per second per API key
RATE_LIMIT_KEY_BURST=200   # Burst size per API key

# Auth Failure Protection
RATE_LIMIT_LOCKOUT_THRESHOLD=10  # Failed attempts before temporary lockout
RATE_LIMIT_LOCKOUT_DURATION=5m   # Lockout duration (5 minutes)

# Cleanup (memory leak prevention)
RATE_LIMIT_CLEANUP_INTERVAL=1m   # How often to clean old entries
RATE_LIMIT_ENTRY_TTL=3m          # TTL for inactive entries
